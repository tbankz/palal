{
  "name": "palal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:netlify",
    "build:netlify": "mkdir -p public && echo 'Netlify build complete'",
    "migrate:local": "node ./scripts/migrate.js --local",
    "migrate:remote": "node ./scripts/migrate.js --remote",
    "start": "npm run serve",
    "dev": "netlify dev",
    "serve": "npx serve ./public",
    "netlify:dev": "netlify dev"
  },
  "dependencies": {
    "@netlify/identity": "^1.2.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "serve": "^14.2.2"
  }
}
